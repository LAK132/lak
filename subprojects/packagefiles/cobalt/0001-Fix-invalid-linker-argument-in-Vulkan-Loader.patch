From 12f179dcb8b9c128ee56afbed5b2a21d077209a9 Mon Sep 17 00:00:00 2001
From: LAK132 <lakridesagain@gmail.com>
Date: Sat, 31 Jan 2026 01:11:08 +1030
Subject: [PATCH 1/2] Fix invalid linker argument in Vulkan-Loader

---
 External/VulkanLibraries/Vulkan-Loader.patch | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/External/VulkanLibraries/Vulkan-Loader.patch b/External/VulkanLibraries/Vulkan-Loader.patch
index 7cf4233..544be6b 100644
--- a/External/VulkanLibraries/Vulkan-Loader.patch
+++ b/External/VulkanLibraries/Vulkan-Loader.patch
@@ -80,3 +80,16 @@ index df7a0460c20c2fcade4fec8a8a895f32ded9d8aa..3605cd19614aec3c664544a4926b5661
                  value = match.group(1)
              if assembler_type == "MASM":
              # MASM uses hex values, decode them here
+diff --git a/CMakeLists.txt b/CMakeLists.txt
+index 52e33d1e1..45c0fc059 100644
+--- a/CMakeLists.txt
++++ b/CMakeLists.txt
+@@ -204,7 +204,7 @@ if(CMAKE_CXX_COMPILER_ID MATCHES "MSVC" OR (CMAKE_CXX_COMPILER_ID STREQUAL "Clan
+     target_compile_options(loader_common_options INTERFACE /GR- /guard:cf /wd4152 /wd4201)
+ 
+     # Enable control flow guard
+-    target_link_options(loader_common_options INTERFACE "LINKER:/guard:cf")
++    target_link_options(loader_common_options INTERFACE "/guard:cf")
+ 
+     # Prevent <windows.h> from polluting the code. guards against things like MIN and MAX
+     target_compile_definitions(loader_common_options INTERFACE WIN32_LEAN_AND_MEAN)
-- 
2.54.0

