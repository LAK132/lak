From 6d0c8a0deae2a056b5d136045e356ee86d99f56f Mon Sep 17 00:00:00 2001
From: LAK132 <lakridesagain@gmail.com>
Date: Thu, 2 Jul 2026 19:18:24 +0930
Subject: [PATCH] Make LogManager move constructible

---
 Libraries/Cobalt/Logging/LogManager.h   | 1 +
 Libraries/Cobalt/Logging/LogManager.inl | 7 +++++++
 2 files changed, 8 insertions(+)

diff --git a/Libraries/Cobalt/Logging/LogManager.h b/Libraries/Cobalt/Logging/LogManager.h
index 59e2964..d6dd34a 100644
--- a/Libraries/Cobalt/Logging/LogManager.h
+++ b/Libraries/Cobalt/Logging/LogManager.h
@@ -17,6 +17,7 @@ public:
 public:
 	// Constructors
 	inline LogManager();
+	inline LogManager(LogManager&& other);
 
 	// Severity methods
 	inline ILogger::SeverityFilter GetIncludeSeverity() const;
diff --git a/Libraries/Cobalt/Logging/LogManager.inl b/Libraries/Cobalt/Logging/LogManager.inl
index c3c2cef..68d2bce 100644
--- a/Libraries/Cobalt/Logging/LogManager.inl
+++ b/Libraries/Cobalt/Logging/LogManager.inl
@@ -10,6 +10,13 @@ LogManager::LogManager()
 : _severityFilter(ILogger::SeverityFilter::All)
 {}
 
+LogManager::LogManager(LogManager&& other)
+{
+	std::lock_guard<std::mutex> lock(other._accessMutex);
+	_logTargetEntries = std::exchange(other._logTargetEntries, {});
+	_severityFilter.store(other._severityFilter.load());
+}
+
 //----------------------------------------------------------------------------------------------------------------------
 // Severity methods
 //----------------------------------------------------------------------------------------------------------------------
