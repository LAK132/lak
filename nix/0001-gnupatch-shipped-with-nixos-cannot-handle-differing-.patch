 endings, even with --ignore-whitespace. Use git instead

---
 mesonbuild/wrap/wrap.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/mesonbuild/wrap/wrap.py b/mesonbuild/wrap/wrap.py
index fc5c637af..86db87363 100644
--- a/mesonbuild/wrap/wrap.py
+++ b/mesonbuild/wrap/wrap.py
@@ -74,7 +74,7 @@ if mesonlib.is_windows():
         _exclude_paths.append(os.path.dirname(_patch.get_path()))
     PATCH = _patch.get_path() if _patch.found() else None
 else:
-    PATCH = shutil.which('patch')
+    PATCH = None
 
 
 truststore_message = '''
